{
  "name": "socketdocs",
  "private": true,
  "version": "0.2.0",
  "description": "OpenAPI-style documentation framework for WebSocket APIs",
  "keywords": [
    "websocket",
    "openapi",
    "documentation",
    "validation",
    "zod",
    "json-schema",
    "realtime",
    "socket.io",
    "fastify",
    "nestjs",
    "typescript"
  ],
  "author": "Nwankwo Samuel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/socketdocs.git"
  },
  "bugs": {
    "url": "https://github.com/saminwankwo/socketdocs/issues"
  },
  "homepage": "https://github.com/saminwankwo/socketdocs#readme",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
