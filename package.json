{
  "name": "socketdocs",
  "private": true,
  "version": "1.0.0-alpha.0",
  "description": "Swagger-style documentation for Socket.IO",
  "keywords": [
    "websocket",
    "socket.io",
    "documentation",
    "openapi",
    "swagger",
    "zod",
    "json-schema",
    "realtime",
    "nestjs",
    "typescript"
  ],
  "author": "Nwankwo Samuel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/socket-doc.git"
  },
  "bugs": {
    "url": "https://github.com/saminwankwo/socket-doc/issues"
  },
  "homepage": "https://github.com/saminwankwo/socket-doc#readme",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "rm -rf packages/*/dist && rm -rf packages/*/tsconfig.tsbuildinfo",
    "build": "npm run clean && npm run build:ui && tsc -b && npm run copy:express-ui",
    "build:ui": "cd packages/ui && npm run build",
    "copy:express-ui": "cd packages/express && npm run copy:ui",
    "test": "npm test --workspaces --if-present",
    "check:examples": "node scripts/check-examples.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "check:circular": "madge --circular --extensions ts,tsx packages/*/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "knip": "^6.41.0",
    "madge": "^5.0.2",
    "prettier": "^3.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3"
  }
}
