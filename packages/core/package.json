{
  "name": "@socketdocs/core",
  "version": "0.2.0",
  "type": "module",
  "description": "Core engine for SocketDocs, providing contract definitions and validation logic.",
  "keywords": [
    "socketdocs",
    "websocket",
    "validation",
    "zod",
    "json-schema",
    "contract-first"
  ],
  "author": "Nwankwo Samuel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/socketdocs.git",
    "directory": "packages/core"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config ./jest.config.cjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "ajv": "^8.20.0"
  }
}
