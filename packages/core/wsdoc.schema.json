{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SocketDocs Spec",
  "type": "object",
  "required": ["specVersion", "info", "namespaces"],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "info": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "description": { "type": "string" },
          "auth": {
            "type": "object",
            "properties": {
              "type": { "enum": ["bearer", "apiKey", "none"] }
            }
          }
        }
      }
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["events"],
        "properties": {
          "description": { "type": "string" },
          "events": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["direction"],
              "properties": {
                "direction": { "enum": ["client_to_server", "server_to_client", "bidirectional"] },
                "type": { "enum": ["fire_and_forget", "request_response"] },
                "summary": { "type": "string" },
                "description": { "type": "string" },
                "payloadSchema": { "type": ["object", "null"] },
                "responseSchema": { "type": ["object", "null"] },
                "authRequired": { "type": "boolean" },
                "roles": { "type": "array", "items": { "type": "string" } },
                "examples": { "type": "array" },
                "errors": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
