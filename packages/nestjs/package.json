{
  "name": "@socketdocs/nestjs",
  "version": "1.0.0-alpha.0",
  "type": "module",
  "description": "NestJS module and decorators for SocketDocs.",
  "keywords": [
    "socketdocs",
    "nestjs",
    "socket.io",
    "swagger",
    "websocket"
  ],
  "author": "Nwankwo Samuel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/socketdocs.git",
    "directory": "packages/nestjs"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@socketdocs/core": "1.0.0-alpha.0",
    "@socketdocs/express": "1.0.0-alpha.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/websockets": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "socket.io": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "express": "^4.22.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vitest": "^2.1.5",
    "zod": "^4.4.3"
  }
}
