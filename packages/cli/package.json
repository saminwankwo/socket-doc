{
  "name": "@socketdocs/cli",
  "version": "1.0.0-alpha.0",
  "description": "Minimal CLI for SocketDocs: lint a spec and export it to AsyncAPI.",
  "keywords": [
    "socketdocs",
    "cli",
    "socket.io",
    "asyncapi",
    "lint",
    "swagger"
  ],
  "author": "Nwankwo Samuel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/socket-doc.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/saminwankwo/socket-doc#readme",
  "bugs": {
    "url": "https://github.com/saminwankwo/socket-doc/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "socketdocs": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@socketdocs/core": "1.0.0-alpha.0"
  },
  "devDependencies": {
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
